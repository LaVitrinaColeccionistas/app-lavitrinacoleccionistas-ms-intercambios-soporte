<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <!-- CONFIGURACIÓN EXTERNA -->
    <property name="LOG_PATH"
              value="${LOG_PATH:-logs}"/>

    <property name="LOG_FILE"
              value="${LOG_FILE:-intercambios-soporte.log}"/>

    <springProperty name="LOG_LEVEL"
                    source="LOG_LEVEL"
                    defaultValue="INFO"/>

    <property name="SQL_LOG_LEVEL"
              value="${SQL_LOG_LEVEL:-DEBUG}"/>

    <property name="LOG_MAX_FILE_SIZE"
              value="${LOG_MAX_FILE_SIZE:-10MB}"/>

    <property name="LOG_MAX_HISTORY"
              value="${LOG_MAX_HISTORY:-30}"/>

    <property name="LOG_TOTAL_SIZE_CAP"
              value="${LOG_TOTAL_SIZE_CAP:-500MB}"/>

    <property name="LOG_PATTERN"
              value="${LOG_PATTERN:-%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n}"/>


    <!-- CONSOLA -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>


    <!-- ARCHIVO -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/${LOG_FILE}</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/intercambios-soporte-%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>

            <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>

            <maxHistory>${LOG_MAX_HISTORY}</maxHistory>

            <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>

        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>


    <!-- SQL / REPOSITORY -->
    <logger name="org.hibernate.SQL"
            level="${SQL_LOG_LEVEL}"/>


    <!-- APLICACIÓN -->
    <logger name="py.com.lavitrinacoleccionistas.intercambiossoporte"
            level="${LOG_LEVEL}"/>

    <logger name="org.springframework.data.redis.cache"
            level="${REDIS_LOG_LEVEL:-TRACE}"/>

    <logger name="org.springframework.cache.interceptor"
            level="${REDIS_LOG_LEVEL:-TRACE}"/>


    <!-- ROOT -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>